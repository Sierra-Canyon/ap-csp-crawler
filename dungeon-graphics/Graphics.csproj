<Project Sdk="Microsoft.NET.Sdk">

  <!-- The graphical game. It compiles the SAME student files as ../dungeon
       (everything except Program.cs) and draws them with Raylib. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>dungeon-graphics</AssemblyName>
    <NoWarn>$(NoWarn);CS8321</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <StitchPiece Include="Main.cs" />
    <StitchPiece Include="../dungeon/*.cs" Exclude="../dungeon/Program.cs" />
    <Compile Include="Engine/*.cs" />
    <None Include="Main.cs" />
    <Content Include="../assets/**/*" Link="assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="../dungeon/Stitch.targets" />

</Project>
