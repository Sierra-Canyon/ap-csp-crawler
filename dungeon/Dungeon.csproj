<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>dungeon</AssemblyName>
    <!-- CS8321 = "function is never called". Normal while students are mid-unit. -->
    <NoWarn>$(NoWarn);CS8321</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Program.cs goes first; then every other .cs file in this folder.
       practice/ is left out so practice copies never clash with the real functions. -->
  <ItemGroup>
    <StitchPiece Include="Program.cs" />
    <StitchPiece Include="*.cs" Exclude="Program.cs" />
    <None Include="*.cs;practice/**/*.cs" />
  </ItemGroup>

  <Import Project="Stitch.targets" />

</Project>
